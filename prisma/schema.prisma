// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String   @id @default(uuid())
  email              String   @unique
  password           String
  name               String
  role               String   @default("operator")
  biometricPublicKey String?  @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model VehicleEntry {
  id            String    @id @default(uuid())
  plate         String
  vehicleType   String
  isVip         Boolean   @default(false)
  branchId      String
  branch        Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  platePhotoUrl String?
  frontPhotoUrl String?
  rearPhotoUrl  String?
  leftPhotoUrl  String?
  rightPhotoUrl String?
  exitedAt      DateTime?
  createdAt     DateTime  @default(now())

  @@index([branchId])
  @@index([plate])
}

model Branch {
  id      String  @id @default(uuid())
  name    String
  address String?

  motorcycleCapacity   Int @default(0)
  lightVehicleCapacity Int @default(0)
  heavyVehicleCapacity Int @default(0)

  motorcycleRate   Float @default(0.0)
  lightVehicleRate Float @default(0.0)
  heavyVehicleRate Float @default(0.0)

  currency String @default("USD")
  favorite Boolean @default(false)

  vehicleEntries VehicleEntry[]
  memberships    Membership[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Membership {
  id         String   @id @default(uuid())
  memberName String
  tier       String   @default("Regular")
  startDate  DateTime
  endDate    DateTime
  isActive   Boolean  @default(true)
  branchId   String
  branch     Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([branchId])
}
