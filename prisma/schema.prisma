// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String   @id @default(uuid())
  email              String   @unique
  password           String
  name               String
  role               String   @default("operator")
  biometricPublicKey String?  @db.Text
  avatarUrl          String?
  lastModifiedAt     BigInt   @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model VehicleEntry {
  id            String      @id @default(uuid())
  plate         String
  vehicleType   String
  isVip         Boolean     @default(false)
  membershipId  String?
  membership    Membership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  branchId      String
  branch        Branch      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  platePhotoUrl String?
  frontPhotoUrl String?
  rearPhotoUrl  String?
  leftPhotoUrl  String?
  rightPhotoUrl String?
  exitedAt      DateTime?
  lastModifiedAt BigInt    @default(0)
  createdAt     DateTime    @default(now())

  @@index([branchId])
  @@index([plate])
  @@index([membershipId])
}

model Branch {
  id      String  @id @default(uuid())
  name    String
  address String?

  motorcycleCapacity   Int @default(0)
  lightVehicleCapacity Int @default(0)
  heavyVehicleCapacity Int @default(0)

  motorcycleRate   Float @default(0.0)
  lightVehicleRate Float @default(0.0)
  heavyVehicleRate Float @default(0.0)

  motorcycleOvernightRate   Float @default(0.0)
  lightVehicleOvernightRate Float @default(0.0)
  heavyVehicleOvernightRate Float @default(0.0)

  openTimeWeekday  String @default("07:00")
  closeTimeWeekday String @default("23:00")
  openTimeWeekend  String @default("09:00")
  closeTimeWeekend String @default("22:00")

  currency String @default("USD")
  favorite Boolean @default(false)

  lastModifiedAt   BigInt     @default(0)
  vehicleEntries   VehicleEntry[]
  memberships      Membership[]

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Membership {
  id            String         @id @default(uuid())
  memberName    String
  tier          String         @default("Regular")
  cardUuid      String?        @unique
  startDate     DateTime
  endDate       DateTime
  isActive      Boolean        @default(true)
  branchId      String
  branch        Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  vehicleEntries VehicleEntry[]
  lastModifiedAt BigInt        @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([branchId])
}

model ChangeJournal {
  id            BigInt   @id @default(autoincrement())
  entityType    String
  entityId      String
  operation     String
  data          Json
  changedFields Json?
  timestamp     BigInt
  deviceId      String
  createdAt     DateTime @default(now())

  @@index([entityType, entityId])
  @@index([timestamp])
  @@index([deviceId])
}
